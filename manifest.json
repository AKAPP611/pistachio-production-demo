  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://your-github-username.github.io/pistachio-production/"
    }
  ],
  "prefer_related_applications": false,
  "share_target": {
    "action": "/share-handler",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "file",
          "accept": [
            "text/csv",
            "application/json",
            ".csv",
            ".json"
          ]
        }
      ]
    }
  },
  "protocol_handlers": [
    {
      "protocol": "web+pistachio",
      "url": "/handler?type=%s"
    }
  ],
  "file_handlers": [
    {
      "action": "/file-handler",
      "accept": {
        "text/csv": [".csv"],
        "application/json": [".json"]
      }
    }
  ],
  "edge_side_panel": {
    "preferred_width": 400
  },
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "handle_links": "preferred"
}